<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit_config_id" model="ir.ui.view">
            <field name="name">account.move.form.inherit.config_id</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='l10n_mx_edi_cfdi_origin']" position="after">
                    <!-- ✅ Campo “de control” siempre presente en la vista -->
                    <field name="x_is_global_pdv" invisible="1"/>
                    <field name="x_global_periodicity" readonly="state == 'posted'"
                           invisible="not x_is_global_pdv or (move_type != 'out_invoice' and move_type != 'out_refund')"/>
                    <field name="x_global_period_date" readonly="state == 'posted'"
                           invisible="not x_is_global_pdv or (move_type != 'out_invoice' and move_type != 'out_refund')"/>
                    <field name="x_cfdi_emission_datetime" readonly="state == 'posted'"
                           invisible="not x_is_global_pdv or (move_type != 'out_invoice' and move_type != 'out_refund')"/>
                </xpath>
                <xpath expr="//field[@name='invoice_date']" position="before">
                    <field name="config_id" invisible="not config_id" readonly="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>