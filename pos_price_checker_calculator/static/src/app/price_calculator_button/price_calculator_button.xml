<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_price_checker_calculator.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('navbar-menu')]" position="after">
            <button class="btn btn-primary d-flex align-items-center gap-1 h-100 ms-1 p-2 price-calculator-nav-btn"
                    title="Calculadora y Buscador de Precios (F4)"
                    t-on-click="() => this.openPriceCalculator()">
                <i class="fa fa-calculator" aria-hidden="true"/>
                <span t-if="!this.ui.isSmall" class="fw-bold">Calculadora (F4)</span>
            </button>
        </xpath>
    </t>

</templates>
