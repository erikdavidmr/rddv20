<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_pricelist_wizard_inherit" model="ir.ui.view">
        <field name="name">product.template.form.pricelist.wizard.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Header con botón principal antes de sheet -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_open_pricelist_assign_wizard"
                            string="Asignar a Listas de Precios"
                            type="object"
                            class="btn-primary"
                            icon="fa-tags"/>
                </header>
            </xpath>

            <!-- Smart button en la caja de botones -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        name="action_open_pricelist_assign_wizard"
                        type="object"
                        icon="fa-list-ol">
                    <field string="En Listas" name="pricelist_rule_count" widget="statinfo"/>
                </button>
            </xpath>

            <!-- Botón de acceso directo junto al precio de venta -->
            <xpath expr="//div[@name='list_price_per_uom_id']" position="after">
                <button name="action_open_pricelist_assign_wizard"
                        type="object"
                        string="Asignar en Listas"
                        icon="fa-pencil"
                        class="btn-link oe_inline p-0 ms-2"/>
            </xpath>
        </field>
    </record>

</odoo>
