<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <record id="ir_cron_update_pricelist" model="ir.cron">
            <field name="name">Actualiza la lista de precios segun su configuracion</field>
            <field name="model_id" ref="model_product_pricelist"/>
            <field name="state">code</field>
            <field name="code">model.cron_change_pricelist_all_companies()</field>
            <field name="interval_number">24</field>
            <field name="interval_type">hours</field>
        </record>

        <record id="ir_cron_pos_email" model="ir.cron">
            <field name="name">Notifica si hay una caja abierta</field>
            <field name="model_id" ref="model_product_pricelist"/>
            <field name="state">code</field>
            <field name="code">model.search([]).cron_pos_abierto()</field>
            <field name="interval_number">24</field>
            <field name="interval_type">hours</field>
        </record>

        <record id="ir_cron_product_puc_update" model="ir.cron">
            <field name="name">Actualizar valor puc en automatico</field>
            <field name="model_id" ref="model_product_template"/>
            <field name="state">code</field>
            <field name="code">model.cron_update_puc_all_companies()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
        </record>

        <record id="cron_migration_step1" model="ir.cron">
            <field name="name">PUC Migration - Step 1 (Backup and Clean)</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">model.migrar_puc()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
        </record>


    </data>
</odoo>