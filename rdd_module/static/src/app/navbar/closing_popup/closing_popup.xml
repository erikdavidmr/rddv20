<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">
        <xpath expr="//Dialog" position="replace">
            <Dialog contentClass="'close-pos-popup'" bodyClass="'pt-2 pb-1'">
                <t t-set-slot="header">
                    <div class="d-flex flex-grow-1 justify-content-between mb-2">
                        <h4 class="align-middle my-1 fs-2">Closing Register</h4>
                        <div class="total-orders fw-bolder align-middle my-1">
                            <t t-out="this.props.orders_details.quantity"/> orders:
                            <span class="amount" t-out="this.pos.formatCurrency(this.props.orders_details.amount)"/>
                        </div>
                    </div>
                </t>
                <div class="row g-3">
                    <div class="col-12" t-if="this.pos.config.cash_control">
                        <label class="form-label">Cash Count</label>
                        <div class="d-flex w-100 gap-2 mt-1">
                            <CashInput
                                class="'cash-input w-100'"
                                tModel="[this.state.payments[this.props.default_cash_details.id], 'counted']"
                                isValid="(value) => this.pos.isValidFloat(value)"
                                onBlur="() => this.handleCashCountBlur()"
                            />
                            <button
                                class="icon oi btn btn-secondary"
                                data-icon="payments"
                                t-on-click="this.openDetailsPopup"
                            />
                        </div>
                    </div>
                    <div class="notes-container d-flex flex-column flex-sm-row gap-3 pt-3">
                        <div
                            t-if="this.props.opening_notes"
                            class="opening-notes-container d-flex flex-column flex-grow-1 align-items-start"
                        >
                            <label class="form-label" for="opening_notes">Opening note</label>
                            <textarea
                                id="opening_notes"
                                class="opening-notes form-control"
                                rows="7"
                                style="height: 60px"
                                t-att-value="this.props.opening_notes"
                                readonly="readonly"
                            />
                        </div>
                        <div class="closing-notes-container d-flex flex-column flex-grow-1 align-items-start">
                            <label class="form-label" for="closingNotes">Closing note</label>
                            <textarea
                                id="closingNotes"
                                class="closing-notes form-control"
                                style="height: 60px"
                                rows="7"
                                placeholder="Add a closing note..."
                                t-model.proxy="this.state.notes"
                            />
                        </div>
                    </div>
                </div>
                <t t-set-slot="footer">
                    <div class="w-100 d-flex flex-wrap justify-content-between gap-2" t-att-class="{'container-fluid row p-0': this.ui.isSmall}">
                        <div t-att-class="{'col-12 col-md-6 p-0': this.ui.isSmall}" class="d-flex gap-2">
                            <button
                                class="button highlight btn btn-primary"
                                t-att-disabled="!this.canConfirm()"
                                t-on-click="this.confirm"
                                t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'"
                            >Close Register</button>
                            <button
                                class="button btn btn-secondary"
                                t-att-disabled="!this.canCancel()"
                                t-on-click="this.cancel"
                                t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'"
                            >Discard</button>
                        </div>
                        <div t-att-class="{'col-12 col-md-6 p-0': this.ui.isSmall}" class="d-flex gap-2">
                            <button
                                class="button btn btn-secondary"
                                t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'"
                                t-on-click="() => this.cashMove()"
                            >Cash In/Out</button>
                        </div>
                    </div>
                </t>
            </Dialog>
        </xpath>
    </t>
</templates>
