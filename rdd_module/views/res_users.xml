<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_rdd_inherit" model="ir.ui.view">
        <field name="name">view.users.rdd.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_warehouse_id']" position="after">
                <field name="user_warehouse" widget="many2many_tags" domain="[('company_id', 'in', company_ids)]" />
                
            </xpath>

        </field>
    </record>


</odoo>