<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']/group[@name='sale']" position="after">
                <group name="uom_price" string="UOM Price" invisible='not available_in_pos'>
                    <field name="multi_uom_price_ids" colspan="2" nolabel="1" widget="one2many">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="uom_id"/>
                            <field name="barcode"/>
                            <field name="price" widget='monetary' options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                        </list>
                    </field>                                
                </group>
            </xpath>
        </field>
    </record>
</odoo>
