<?xml version="1.0"?>
<odoo>
    <record model="ir.ui.view" id="res_config_settings_view_form">
        <field name="name">res.config.settings.view.form.add_multi_price_uom</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting string="Enable Multi Price Uom" help="Enable multi price uom">
                    <field name="ka_multi_uom"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
