<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_card_surcharge_pricelist.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('navbar-menu')]" position="after">
            <button t-if="this.showCardSurchargeToggle and this.pos.getOrder()"
                    class="btn btn-lg lh-lg ms-1 d-flex align-items-center gap-1 card-surcharge-nav-btn"
                    t-att-class="this.isCardPricelistActive ? 'btn-warning active fw-bold text-dark' : 'btn-outline-secondary'"
                    title="Alternar tarifa entre Efectivo y Tarjeta (+2%)"
                    t-on-click="() => this.toggleCardPricelist()">
                <i t-att-class="this.isCardPricelistActive ? 'fa fa-credit-card' : 'fa fa-money'" aria-hidden="true"/>
                <span t-if="!this.ui.isSmall">
                    <t t-if="this.isCardPricelistActive">💳 Tarjeta (+2%)</t>
                    <t t-else="">💵 Efectivo</t>
                </span>
            </button>
        </xpath>
    </t>

</templates>
