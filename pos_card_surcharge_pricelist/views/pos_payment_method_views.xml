<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.card_surcharge</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="before">
                <field name="apply_card_surcharge"/>
            </xpath>
        </field>
    </record>

    <record id="pos_payment_method_view_tree_inherit" model="ir.ui.view">
        <field name="name">pos.payment.method.tree.inherit.card_surcharge</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="apply_card_surcharge" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
