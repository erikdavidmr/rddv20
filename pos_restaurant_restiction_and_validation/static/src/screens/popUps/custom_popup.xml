<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_restaurant_restiction_and_validation.ManagerSelectPopup">
        <Dialog title="Manager Approval">
            <div class="popup popup-textarea">
                <div class="modal-body">
                    <label>Manager</label>
                    <select class="form-control" t-model="state.selectedManagerId">
                        <t t-foreach="props.managers" t-as="mgr">
                            <option t-att-value="mgr.id"><t t-esc="mgr.name"/></option>
                        </t>
                    </select>
                    <label class="mt-3">PIN</label>
                    <input type="password" t-model="state.pin" class="form-control" placeholder="Enter PIN"/>
                    <t t-if="errorMessage">
                        <div class="text-danger mt-2"><t t-esc="errorMessage"/></div>
                    </t>
                </div>
                <t t-set-slot="footer">
                    <button class="btn btn-primary" t-on-click="confirm">Confirm</button>
                    <button class="btn btn-secondary" t-on-click="cancel">Cancel</button>
                </t>
            </div>
        </Dialog>
    </t>
</templates>
